# Environment for ROSE compiler development.

# Pull base image.
FROM ubuntu:22.04

# Install packages.
RUN \
    apt-get update && \
    apt-get install -y \
        apt-utils \
        dialog \
        software-properties-common && \
    apt-get install -y openjdk-11-jdk && \
    apt-get install -y \ 
        automake \
        autotools-dev \
        bison \
        build-essential \
        cmake \
        curl \
        flex \
        g++-9 \
        gdb \
        gfortran-9 \
        ghostscript \
        git \
        graphviz \
        libboost-all-dev \
        libtool \
        python3-dev \
        vim \
        wget && \
  rm -rf /var/lib/apt/lists/* && \
  rm -rf /var/cache/*

# Setup environment
ENV ROSE_SRC /opt/rose_src
ENV ROSE_PATH /opt/rose
ENV ROSE_BUILD /opt/rose_build
ENV PATH $ROSE_PATH/bin:$PATH
ENV LD_LIBRARY_PATH $ROSE_PATH/lib:$LD_LIBRARY_PATH
ENV LIBRARY_PATH $ROSE_PATH/lib:$LIBRARY_PATH

# Define commonly used JAVA_HOME variable
ENV JAVA_HOME /usr/lib/jvm/java-11-openjdk-amd64
ENV LD_LIBRARY_PATH $JAVA_HOME/lib/server:/usr/lib/x86_64-linux-gnu

# Username doesn't need to be defined. The host user has to be passed into Docker for correct file permissions.
RUN cd /opt && \
    mkdir -p $ROSE_PATH && \
    mkdir -p $ROSE_BUILD && \
    git clone https://github.com/rose-compiler/rose.git $ROSE_SRC && \
    cd $ROSE_SRC && \
    ./build && \
    cd $ROSE_BUILD && \
    CC=gcc-9 CXX=g++-9 FC=gfortran-9 $ROSE_SRC/configure --prefix=$ROSE_PATH --with-boost=/usr --with-boost-libdir=/usr/lib/x86_64-linux-gnu --enable-languages=c,c++,fortran --with-gomp_omp_runtime_library=/usr/lib/gcc/x86_64-linux-gnu/9 && \
    cd $ROSE_BUILD && \
    make install-tools -j6 && \
    make check-core && \
    make check-tools && \
    cd /opt && \
    rm -rf $ROSE_SRC $ROSE_BUILD

# Define default command.
CMD ["bash"]
